{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "rig/error.json",
  "title": "RigError",
  "description": "The closed set of ways the rig layer fails. Written to stderr as JSON, exit code 1.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contractVersion",
    "code",
    "message"
  ],
  "properties": {
    "contractVersion": {
      "type": "string",
      "enum": [
        "1.0",
        "1.1"
      ]
    },
    "code": {
      "type": "string",
      "enum": [
        "INVALID_REQUEST",
        "GLB_MISSING",
        "CHECKSUM_MISMATCH",
        "BLENDER_MISSING",
        "BLENDER_FAILED",
        "RIG_FAILED",
        "TIMEOUT",
        "OUTPUT_WRITE_FAILED",
        "GLB_INVALID"
      ]
    },
    "message": {
      "type": "string"
    },
    "detail": {
      "type": "string"
    }
  }
}
