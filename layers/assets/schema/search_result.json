{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "assets/search_result.json",
  "title": "AssetSearchResult",
  "description": "Params out for a catalogue search: what matched, cheapest first, with the licence attached to every entry.",
  "type": "object",
  "additionalProperties": false,
  "required": ["contractVersion", "source", "total", "assets", "elapsedMs"],
  "properties": {
    "contractVersion": { "type": "string", "const": "1.0" },
    "source": { "type": "string", "enum": ["polyhaven"] },
    "query": { "type": "string" },
    "total": { "type": "integer", "minimum": 0, "description": "Matches before the limit was applied." },
    "assets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "license", "thumbnailUrl"],
        "properties": {
          "id": { "type": "string", "description": "Pass this to fetch." },
          "name": { "type": "string" },
          "license": { "type": "string", "enum": ["CC0"], "description": "Every asset from this source is CC0: no attribution required, redistribution allowed. The layer refuses to surface anything else." },
          "authors": { "type": "array", "items": { "type": "string" } },
          "categories": { "type": "array", "items": { "type": "string" } },
          "tags": { "type": "array", "items": { "type": "string" } },
          "triangles": { "type": "integer", "minimum": 0, "description": "The library's own polycount, absent when it does not report one." },
          "thumbnailUrl": { "type": "string" }
        }
      }
    },
    "elapsedMs": { "type": "integer", "minimum": 0 }
  }
}
