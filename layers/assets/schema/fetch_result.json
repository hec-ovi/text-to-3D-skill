{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "assets/fetch_result.json",
  "title": "AssetFetchResult",
  "description": "Params out for a fetch: one self-contained GLB by reference, plus where it came from.",
  "type": "object",
  "additionalProperties": false,
  "required": ["contractVersion", "source", "id", "glb", "license", "elapsedMs"],
  "properties": {
    "contractVersion": { "type": "string", "const": "1.0" },
    "source": { "type": "string", "enum": ["polyhaven"] },
    "id": { "type": "string" },
    "glb": {
      "type": "object",
      "description": "Shape-compatible with image2mesh's MeshResult.glb, so a fetched asset and a generated one are handled the same way.",
      "additionalProperties": false,
      "required": ["uri", "mediaType", "byteSize", "checksum"],
      "properties": {
        "uri": { "type": "string" },
        "mediaType": { "type": "string", "const": "model/gltf-binary" },
        "byteSize": { "type": "integer", "minimum": 1 },
        "checksum": {
          "type": "object",
          "additionalProperties": false,
          "required": ["sha256"],
          "properties": { "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" } }
        }
      }
    },
    "license": { "type": "string", "enum": ["CC0"] },
    "resolution": { "type": "string" },
    "downloadedBytes": { "type": "integer", "minimum": 0, "description": "Bytes pulled from the library, which is larger than the GLB when textures are recompressed." },
    "elapsedMs": { "type": "integer", "minimum": 0 }
  }
}
