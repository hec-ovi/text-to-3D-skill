{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "assets/error.json",
  "title": "AssetError",
  "description": "The closed set of ways the assets layer fails. Written to stderr as JSON, exit code 1.",
  "type": "object",
  "additionalProperties": false,
  "required": ["contractVersion", "code", "message"],
  "properties": {
    "contractVersion": { "type": "string", "const": "1.0" },
    "code": {
      "type": "string",
      "enum": [
        "INVALID_REQUEST",
        "LIBRARY_UNREACHABLE",
        "LIBRARY_ERROR",
        "ASSET_MISSING",
        "NO_GLTF",
        "BLENDER_MISSING",
        "CONVERT_FAILED",
        "TIMEOUT",
        "OUTPUT_WRITE_FAILED"
      ]
    },
    "message": { "type": "string" },
    "detail": { "type": "string" }
  }
}
