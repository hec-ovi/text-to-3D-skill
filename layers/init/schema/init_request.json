{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "InitRequest",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "contractVersion": { "const": "1.0", "default": "1.0" },
    "toolkitDir": { "type": "string", "minLength": 1 },
    "comfyDir": { "type": "string", "minLength": 1 },
    "modelsDir": { "type": "string", "minLength": 1 },
    "outDir": { "type": "string", "minLength": 1 },
    "runtimeDir": { "type": "string", "minLength": 1 },
    "comfyEndpoint": { "type": "string", "minLength": 1, "default": "http://127.0.0.1:8188" },
    "engineEndpoint": { "type": "string", "minLength": 1, "default": "http://127.0.0.1:8189" },
    "previewHost": { "type": "string", "minLength": 1, "default": "127.0.0.1" },
    "previewPort": { "type": "integer", "minimum": 1, "maximum": 65535, "default": 8190 },
    "fetchModels": { "type": "boolean", "default": true },
    "buildImages": { "type": "boolean", "default": true },
    "startPreview": { "type": "boolean", "default": true },
    "comfyNode": {
      "type": "boolean",
      "default": true,
      "description": "Overlay the sibling ComfyUI stack with the text-to-3d custom node, the shared output directory and a host-gateway route to the engine. false starts ComfyUI exactly as its own project defines it."
    },
    "timeoutSeconds": { "type": "integer", "minimum": 1, "default": 900 }
  }
}
