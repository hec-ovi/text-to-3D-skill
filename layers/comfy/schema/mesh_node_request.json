{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "comfy/mesh_node_request.json",
  "title": "MeshNodeRequest",
  "description": "Params in for the comfy layer: one PNG inline plus the reconstruction settings the resident engine accepts.",
  "type": "object",
  "additionalProperties": false,
  "required": ["image"],
  "properties": {
    "contractVersion": { "type": "string", "const": "1.0" },
    "image": {
      "type": "object",
      "description": "The render, inline. A ComfyUI node is handed pixels in memory, not a path both sides agreed on.",
      "additionalProperties": false,
      "required": ["data", "contentEncoding", "contentMediaType"],
      "properties": {
        "data": { "type": "string", "minLength": 1 },
        "contentEncoding": { "type": "string", "const": "base64" },
        "contentMediaType": { "type": "string", "const": "image/png" },
        "byteSize": { "type": "integer", "minimum": 1 }
      }
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "default": "comfy",
      "description": "Stem for the written GLB. The engine names nothing; this is what a person reads in the gallery."
    },
    "resolution": {
      "type": "integer",
      "enum": [512, 1024, 1536],
      "default": 512,
      "description": "Geometry voxel resolution. 512 runs a single pass; 1024 and 1536 add a cascade."
    },
    "seed": { "type": "integer", "minimum": 0, "default": 42 },
    "targetFaces": {
      "type": "integer",
      "minimum": 100,
      "maximum": 2000000,
      "description": "Quadric simplify target in faces. Omit for the engine's default."
    },
    "backgroundRemoval": {
      "type": "string",
      "enum": ["auto", "threshold", "birefnet"],
      "default": "auto"
    },
    "endpoint": {
      "type": "string",
      "minLength": 1,
      "default": "http://127.0.0.1:8189",
      "description": "Base URL of the resident t2m-server."
    },
    "outDir": { "type": "string", "minLength": 1 },
    "timeoutSeconds": {
      "type": "integer",
      "minimum": 10,
      "maximum": 7200,
      "default": 1800
    }
  }
}
